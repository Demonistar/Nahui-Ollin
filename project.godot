; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fifth Sun: Nahui Ollin"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

GameState="*res://scripts/autoloads/game_state.gd"
SaveSystem="*res://scripts/autoloads/save_system.gd"
GameConfig="*res://scripts/autoloads/game_config.gd"
LoreData="*res://scripts/autoloads/lore_data.gd"
RecipeData="*res://scripts/autoloads/recipe_data.gd"
SceneManager="*res://scripts/autoloads/scene_manager.gd"
AudioManager="*res://scripts/autoloads/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

